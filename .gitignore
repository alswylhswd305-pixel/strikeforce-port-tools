*.tar
*.tar.gz

# OS
.DS_Store
Thumbs.db
desktop.ini

# Generated self-test outputs (rewritten locally; may contain machine paths)
autotester/selftest/coverage_out*
autotester/selftest/blank.png
autotester/selftest/blank_annotated.png
autotester/selftest/blank_annotations.json
autotester/selftest/prev.json
