+s32 cellAtracGetStreamDataInfo(u32 pHandle, u32 ppucWritePointer,
+                               u32 puiWritableByte, u32 puiReadPosition)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    ring_release_consumed(s);
+    if (s->all_on_mem || (s->file_total && s->file_fed >= s->file_total))
+        return (s32)CELL_ATRAC_ERROR_ALLDATA_IS_ONMEMORY;
+    u32 wea = 0;
+    const u32 wr = ring_writable(s, &wea);
+    if (ppucWritePointer) vm_write32(ppucWritePointer, wea);
+    if (puiWritableByte) vm_write32(puiWritableByte, wr);
+    if (puiReadPosition) vm_write32(puiReadPosition, s->file_fed);
+    return CELL_OK;
+}
+
+s32 cellAtracAddStreamData(u32 pHandle, u32 uiAddByte)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    if (s->all_on_mem || uiAddByte == 0) return CELL_OK;
+    u32 wea = 0;
+    const u32 wr = ring_writable(s, &wea);
+    if (uiAddByte > wr) return (s32)CELL_ATRAC_ERROR_ADD_DATA_IS_TOO_BIG;
+    if (s->host) {
+        if (s->file_fed + uiAddByte > s->host_cap)
+            return (s32)CELL_ATRAC_ERROR_ADD_DATA_IS_TOO_BIG;
+        memcpy(s->host + s->file_fed, vm_base + wea, uiAddByte);
+    }
+    s->file_fed += uiAddByte;
+    s->valid_bytes += uiAddByte;
+    if (s->file_total && s->file_fed >= s->file_total) s->all_on_mem = 1;
+    return CELL_OK;
+}
+
+s32 cellAtracGetVacantSize(u32 pHandle, u32 puiVacantSize)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    ring_release_consumed(s);
+    if (s->all_on_mem) {
+        if (puiVacantSize) vm_write32(puiVacantSize, 0);
+        return CELL_OK;
+    }
+    if (puiVacantSize) vm_write32(puiVacantSize, ring_writable(s, NULL));
+    return CELL_OK;
+}
