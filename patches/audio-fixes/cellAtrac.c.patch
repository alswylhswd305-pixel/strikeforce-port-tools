-static int looping(const AtracSlot* s) { return s->t.loop_start >= 0 && s->loop_num != 0; }
+/* Release ring bytes the decoder has passed so the title can feed more. */
+static void ring_release_consumed(AtracSlot* s)
+{
+    if (s->all_on_mem || !s->buf_size || !s->t.block_align) return;
+    u32 keep = s->t.data_off + (u32)(s->pos / AT3P_SAMPLES) * s->t.block_align;
+    if (keep < s->t.block_align) keep = 0;
+    else keep -= s->t.block_align;           /* one frame of overlap for a rewind */
+    /* file offset of the oldest byte still in the ring */
+    const u32 oldest = s->file_fed - s->valid_bytes;
+    if (keep <= oldest) return;
+    u32 rel = keep - oldest;
+    if (rel >= s->valid_bytes) rel = s->valid_bytes;
+    s->valid_off = (s->valid_off + rel) % s->buf_size;
+    s->valid_bytes -= rel;
+}
+
+static u32 ring_writable(const AtracSlot* s, u32* write_ea)
+{
+    if (!s->buf_size) { if (write_ea) *write_ea = 0; return 0; }
+    const u32 woff = (s->valid_off + s->valid_bytes) % s->buf_size;
+    if (write_ea) *write_ea = s->buf_ea + woff;
+    u32 room = s->buf_size - s->valid_bytes;
+    const u32 contig = s->buf_size - woff;
+    if (room > contig) room = contig;
+    if (!s->all_on_mem && s->file_total > s->file_fed) {
+        const u32 left = s->file_total - s->file_fed;
+        if (room > left) room = left;
+    }
+    return room;
+}
+
+static s32 remain_frames(const AtracSlot* s)
+{
+    if (s->all_on_mem || (s->file_total && s->file_fed >= s->file_total))
+        return CELL_ATRAC_ALLDATA_IS_ON_MEMORY;
+    if (!s->t.block_align) return 0;
+    const s32 limit = looping(s) ? s->t.loop_end : s->t.end;
+    const s32 cur = s->pos / AT3P_SAMPLES;
+    const s32 endf = (limit + AT3P_SAMPLES - 1) / AT3P_SAMPLES;
+    if (cur >= endf) return 0;
+    s32 last = 0;
+    if (s->file_fed > s->t.data_off)
+        last = (s32)((s->file_fed - s->t.data_off) / s->t.block_align);
+    if (last <= cur) return 0;
+    s32 have = last - cur;
+    const s32 need = endf - cur;
+    if (have >= need)
+        return looping(s) ? CELL_ATRAC_LOOP_STREAM_DATA_IS_ON_MEMORY
+                          : CELL_ATRAC_NONLOOP_STREAM_DATA_IS_ON_MEMORY;
+    return have;
+}
 
