@echo off
setlocal
rem [TEST-SALEM] 1791 SPURSFIX: TEST COPY ONLY. Taskset Shutdown/Join stop old-stage tasks; [sf-lc] lifecycle lines kept. SF_SPURSFIX=0 restores old behaviour. Saud OK 19:56.
title [TEST-SALEM] Strikeforce SPURSFIX 1791
set "SF=%~dp0"
if "%SF:~-1%"=="\" set "SF=%SF:~0,-1%"
set "PS3_VFS_ROOT=%SF%\vfs\dev_bdvd"
set "PS3_HDD0_ROOT=%SF%\sfauto\state_spursfix\hdd0"
set "PS3_HDD1_ROOT=%SF%\sfauto\state_spursfix\hdd1"
set "PS3_GAMEDATA_ROOT=%SF%\sfauto\state_spursfix\gamedata"
set "PS3_DEV_FLASH=%SF_LOCAL_PATH%"
set "PS3_TITLE=[TEST-SALEM] ps3recomp"
set "PS3_HLE_TOP=0"
set "SPU_INTERP_UNLIFTED=1"
set "SPU_INTERP_MISS=1"
set "OSK_AUTO_TEXT=Saud"
set "SF_PADMAP=%SF%\Strikeforce_buttons.ini"
set "PAD_SCRIPT=15:0x0008"
set "PAD_FILE=%SF%\sfauto\ringwatch_work\pad.txt"
set "PAD_NO_XINPUT=1"
set "SF_HLE_LRLOG=1"
set "SF_HLE_LRLOG_DUMP=5"
set "PS3_FSLOG=1"
set "SF_SPURSFIX=1"
set "ELF=%SF_LOCAL_PATH%"
if not exist "%SF%\play_cwd" mkdir "%SF%\play_cwd"
if not exist "%SF%\play_logs" mkdir "%SF%\play_logs"
for /f %%t in ('powershell -NoProfile -Command "Get-Date -f yyyyMMdd-HHmmss"') do set "TS=%%t"
cd /d "%SF%\play_cwd"
"%SF%\sfauto\exe_copies\1791_spursfix\MyGameRecomp.exe" "%ELF%" 1>"%SF%\play_logs\spursfix1791_%TS%_stdout.log" 2>"%SF%\play_logs\spursfix1791_%TS%_stderr.log"
echo Game exited with code %ERRORLEVEL%.
endlocal
