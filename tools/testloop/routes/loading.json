    {"do": "shot", "name": "loading_10s", "title_ar": "شاشة التحميل بعد 10 ثواني", "issues": ["freeze"]},
    {"do": "wait", "secs": 30},
    {"do": "shot", "name": "loading_40s", "title_ar": "شاشة التحميل بعد 40 ثانية", "issues": ["freeze"]},
    {"do": "wait", "secs": 50},
